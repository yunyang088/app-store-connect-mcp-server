{
  "name": "@yunyang088/app-store-connect-mcp-server",
  "version": "1.1.3",
  "description": "MCP server for the App Store Connect API: apps, versions, localizations, screenshots, TestFlight, bundle IDs, devices, users, and analytics.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "appstoreconnect",
    "ios",
    "testflight"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunyang088/app-store-connect-mcp-server.git"
  },
  "homepage": "https://github.com/yunyang088/app-store-connect-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/yunyang088/app-store-connect-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "app-store-connect-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "!dist/src/**/*.bak",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/src/*.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.20.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^18.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  }
}
